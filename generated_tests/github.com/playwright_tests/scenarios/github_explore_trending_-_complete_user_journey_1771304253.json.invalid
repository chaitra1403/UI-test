import com.microsoft.playwright.*;
import org.junit.jupiter.api.*;

import static org.junit.jupiter.api.Assertions.*;

public class GithubExploreTrendingCompleteUserJourneyTest {

    static Playwright playwright;
    static Browser browser;
    BrowserContext context;
    Page page;

    @BeforeAll
    static void setUpAll() {
        playwright = Playwright.create();
        browser = playwright.chromium().launch(new BrowserType.LaunchOptions().setHeadless(true));
    }

    @AfterAll
    static void tearDownAll() {
        browser.close();
        playwright.close();
    }

    @BeforeEach
    void setUp() {
        context = browser.newContext();
        page = context.newPage();
    }

    @AfterEach
    void tearDown() {
        context.close();
    }

    @Test
    void testGithubExploreTrendingCompleteUserJourney() {
        // Step 1: Navigate to Explore page
        page.goto("https://github.com/explore", new Page.GotoOptions().setWaitUntil(WaitUntilState.DOMCONTENTLOADED));
        assertTrue(page.url().contains("/explore"));
        assertTrue(page.getByRole(AriaRole.LINK, new Page.GetByRoleOptions().setName("Trending").setExact(true)).isVisible());

        // Step 2: Click 'Trending' link
        Locator trendingLink = page.getByRole(AriaRole.LINK, new Page.GetByRoleOptions().setName("Trending").setExact(true));
        trendingLink.waitFor(new Locator.WaitForOptions().setState(WaitForSelectorState.VISIBLE));
        trendingLink.click();
        page.waitForURL("**/trending");
        assertTrue(page.url().contains("/trending"));

        // Step 3: Click first trending repository ('alibaba / zvec')
        Locator repoLink = page.getByRole(AriaRole.LINK, new Page.GetByRoleOptions().setName("alibaba / zvec"));
        repoLink.waitFor(new Locator.WaitForOptions().setState(WaitForSelectorState.VISIBLE));
        repoLink.click();
        page.waitForURL("**/alibaba/zvec");
        assertTrue(page.url().contains("/alibaba/zvec"));
        // navigation tabs should be visible, check 'Code'
        assertTrue(page.getByRole(AriaRole.LINK, new Page.GetByRoleOptions().setName("Code").setExact(true)).isVisible());

        // Step 4: Click 'Code' tab
        Locator codeTab = page.getByRole(AriaRole.LINK, new Page.GetByRoleOptions().setName("Code").setExact(true));
        codeTab.waitFor(new Locator.WaitForOptions().setState(WaitForSelectorState.VISIBLE));
        codeTab.click();
        page.waitForURL(url -> url.contains("/alibaba/zvec"));
        // the file list should be visible (expect README.md link exists)
        assertTrue(page.getByRole(AriaRole.LINK, new Page.GetByRoleOptions().setName("README.md, (File)")).isVisible());

        // Step 5: Click 'README.md' link
        Locator readmeLink = page.getByRole(AriaRole.LINK, new Page.GetByRoleOptions().setName("README.md, (File)"));
        readmeLink.waitFor(new Locator.WaitForOptions().setState(WaitForSelectorState.VISIBLE));
        readmeLink.click();
        page.waitForURL(url -> url.contains("/blob/main/README.md"));
        // README content should be visible (look for markdown body)
        assertTrue(page.locator(".markdown-body").isVisible());

        // Step 6: Click Search Bar
        Locator searchBar = page.getByRole(AriaRole.BUTTON, new Page.GetByRoleOptions().setName("Search or jump to…"));
        searchBar.waitFor(new Locator.WaitForOptions().setState(WaitForSelectorState.VISIBLE));
        searchBar.click();
        // Ensure the "Search or jump to…" input is focused (try that input is now focused or visible)
        assertTrue(page.getByPlaceholder("Search GitHub").isVisible());
    }
}
